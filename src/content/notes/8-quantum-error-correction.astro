  <button class="btn sm" onclick="testStab('IZZ')">I⊗Z₂Z₁</button>
  <button class="btn sm" onclick="testStab('ZZZ')">Z⊗Z⊗Z</button>
  <button class="btn sm" onclick="testStab('XXX')">X⊗X⊗X</button>
